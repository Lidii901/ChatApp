# OPENROUTER_API_KEY: Required OpenRouter API key for LLM completions
OPENROUTER_API_KEY=""

# OPENROUTER_MODEL: Free model identifier (e.g. openrouter/free, google/gemma-4-26b-a4b-it:free, nvidia/nemotron-3-super-120b-a12b:free, dots-studio/dots-3-note-preview:free)
OPENROUTER_MODEL="openrouter/free"

# OPENROUTER_BASE_URL: Base API URL for OpenRouter (defaults to https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
